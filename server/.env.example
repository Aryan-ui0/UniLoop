# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/uniloop?retryWrites=true&w=majority
# Any long random string; used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# React dev server address (allowed by CORS)
CLIENT_URL=http://localhost:5173
